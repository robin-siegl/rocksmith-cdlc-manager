{
  "manifest_version": 3,
  "name": "Rocksmith CDLC Manager",
  "version": "0.5.0",
  "minimum_chrome_version": "114",
  "description": "Save Ignition songs for later and see which PC files are installed.",
  "permissions": [
    "storage",
    "nativeMessaging",
    "downloads",
    "sidePanel"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Rocksmith CDLC Manager",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ignition4.customsforge.com/*",
        "https://www.ignition4.customsforge.com/*"
      ],
      "js": [
        "ignition.js"
      ],
      "css": [
        "ignition.css"
      ]
    },
    {
      "matches": ["https://www.mediafire.com/file/*", "https://mediafire.com/file/*"],
      "js": ["mediafire.js"]
    }
  ]
}


